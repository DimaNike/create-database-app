<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="2025-06-user-setup" author="oracle" runOnChange="true">
        <sqlFile path="01-user-setup.sql" splitStatements="false" stripComments="true"/>
    </changeSet>
    <changeSet id="2025-06-set-schema" author="oracle">
        <sql>ALTER SESSION SET CURRENT_SCHEMA = <%= connectionUsername %>;</sql>
    </changeSet>
    <changeSet id="2025-06-tables-setup" author="oracle" runOnChange="true">
        <sqlFile path="02-tables.sql" splitStatements="true" stripComments="true" endDelimiter=";"/>
    </changeSet>

</databaseChangeLog>